{
  "name": "pdf-form-maker",
  "private": true,
  "version": "1.0.0",
  "description": "Turn PDFs into fillable PDF forms (AcroForms) in the browser.",
  "type": "module",
  "scripts": {
    "predev": "npm run sample",
    "dev": "vite",
    "prebuild": "npm run sample",
    "build": "tsc --noEmit && vite build",
    "prebuild:single": "npm run sample",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "pretest": "npm run sample",
    "test": "vitest run",
    "sample": "node scripts/make-samples.mjs src/assets && node scripts/make-icons.mjs public"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
